{
  "name": "adb-qr-cli",
  "version": "0.1.0",
  "description": "Connect Android devices to your PC wirelessly via ADB from the command line",
  "bin": {
    "adb-qr": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "adb",
    "android",
    "qr",
    "wireless",
    "debug",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goddivor/adb-qr-cli.git"
  },
  "homepage": "https://github.com/goddivor/adb-qr-cli#readme",
  "bugs": {
    "url": "https://github.com/goddivor/adb-qr-cli/issues"
  },
  "author": "goddivor",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@inquirer/prompts": "^5.5.0",
    "bonjour-service": "^1.2.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "ora": "^5.4.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.5.0"
  }
}
